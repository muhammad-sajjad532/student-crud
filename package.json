{
  "name": "angular-testing",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "node scripts/clean-reports.mjs results",
    "test": "ng test --no-watch",
    "pretest:watch": "node scripts/clean-reports.mjs results",
    "test:watch": "ng test --watch",
    "test:run": "npm test",
    "pretest:coverage": "node scripts/clean-reports.mjs results",
    "test:coverage": "ng test --coverage --no-watch",
    "test:ci": "npm run test:coverage && node scripts/check-test-results.mjs",
    "preallure:generate": "node scripts/clean-reports.mjs report",
    "allure:generate": "allure generate allure-results --output allure-report --report-name \"Angular unit tests\"",
    "allure:open": "allure open allure-report",
    "allure:clean": "node scripts/clean-reports.mjs all",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "quality-check": "npm run lint && npm run format:check && npm run test:ci && npm run allure:generate && npm run build",
    "serve:ssr:angular-testing": "node dist/angular-testing/server/server.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.8",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "allure": "^3.18.0",
    "allure-js-commons": "^3.12.2",
    "allure-vitest": "^3.12.2",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  }
}
